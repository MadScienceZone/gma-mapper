#!/usr/bin/env sh
# Lightweight POSIX launcher for GMA Mapper (Python/PySide6 port)
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"

if command -v gma-mapper >/dev/null 2>&1; then
    exec gma-mapper "$@"
fi

export PYTHONPATH="${REPO_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}"
if command -v python3 >/dev/null 2>&1; then
    exec python3 -m gma_mapper "$@"
else
    exec python -m gma_mapper "$@"
fi

